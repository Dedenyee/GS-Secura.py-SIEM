# Copie para .env e ajuste. NUNCA versione o .env com senhas reais.

# MongoDB (eventos, alertas, ameacas)
MONGO_URL=mongodb://localhost:27017/
MONGO_DB=securapy
# MONGO_TTL_DIAS=90        # opcional: expira eventos N dias apos a ingestao

# MySQL (usuarios / permissoes)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=securapy
MYSQL_USER=securapy
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Admin inicial criado por: python -m scripts.usuarios init
ADMIN_EMAIL=admin@cybershield.com
ADMIN_SENHA=troque-esta-senha-admin

# Enriquecimento (opcional)
# IPINFO_TOKEN=

# Servidor de alertas TCP
ALERTAS_HOST=0.0.0.0
ALERTAS_PORTA=9999
